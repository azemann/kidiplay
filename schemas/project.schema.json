{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/project-template/project.schema.json",
  "title": "Project technology and delivery manifest",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/legacyManifest" },
    { "$ref": "#/$defs/v3Manifest" }
  ],
  "$defs": {
    "legacyManifest": {
      "type": "object",
      "required": ["schema_version", "project", "components"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "enum": [1, 2] },
        "project": { "$ref": "#/$defs/project" },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/legacyComponent" }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/legacyArtifact" }
        },
        "pipelines": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/legacyPipeline" }
        },
        "environments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/legacyEnvironment" }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/secretReference" }
        },
        "evidence": { "type": "object" }
      }
    },
    "v3Manifest": {
      "type": "object",
      "required": ["schema_version", "project", "components", "delivery"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 3 },
        "project": { "$ref": "#/$defs/project" },
        "components": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/component" }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/artifact" }
        },
        "pipelines": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/pipeline" }
        },
        "environments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/environment" }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/secretReference" }
        },
        "delivery": { "$ref": "#/$defs/delivery" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "project": {
      "type": "object",
      "required": ["name", "kind", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "legacyCommand": {
      "type": "object",
      "required": ["status", "argv"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "working_directory": { "type": "string" }
      }
    },
    "legacyComponent": {
      "type": "object",
      "required": ["root", "languages", "toolchain", "targets", "commands", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string" },
        "languages": { "type": "object" },
        "toolchain": { "type": "object" },
        "targets": { "$ref": "#/$defs/stringList" },
        "commands": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/legacyCommand" }
        },
        "artifacts": { "$ref": "#/$defs/stringList" }
      }
    },
    "legacyArtifact": {
      "type": "object",
      "required": ["type", "produced_by", "retention_days"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["path"] },
        { "required": ["reference"] }
      ],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "produced_by": { "$ref": "#/$defs/id" },
        "retention_days": { "type": "integer", "minimum": 1 },
        "platform": { "type": "string" },
        "architecture": { "type": "string" },
        "digest_algorithm": { "enum": ["sha256", "sha512"] },
        "sbom": { "type": "boolean" },
        "signed": { "type": "boolean" }
      }
    },
    "legacyOperation": {
      "type": "object",
      "required": ["phase", "uses"],
      "additionalProperties": false,
      "properties": {
        "phase": { "enum": ["verify", "produce", "deliver", "operate"] },
        "uses": { "$ref": "#/$defs/id" },
        "component": { "$ref": "#/$defs/id" },
        "command": { "$ref": "#/$defs/legacyCommand" },
        "needs": { "$ref": "#/$defs/stringList" },
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "environment": { "$ref": "#/$defs/id" },
        "secrets": { "$ref": "#/$defs/stringList" },
        "condition": { "type": "object" },
        "timeout_minutes": { "type": "integer", "minimum": 1 },
        "idempotent": { "type": "boolean" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },
    "legacyPipeline": {
      "type": "object",
      "required": ["orchestrator", "operations"],
      "additionalProperties": false,
      "properties": {
        "orchestrator": { "$ref": "#/$defs/id" },
        "triggers": { "$ref": "#/$defs/stringList" },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/legacyOperation" }
        }
      }
    },
    "legacyEnvironment": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "targets": { "$ref": "#/$defs/stringList" },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "boolean" },
            "minimum": { "type": "integer", "minimum": 0 }
          }
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_operations": { "$ref": "#/$defs/stringList" },
            "require_signed_artifacts": { "type": "boolean" }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "enum": ["recreate", "rolling", "blue-green", "canary", "manual"]
            },
            "rollback_operation": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "languages": {
      "type": "object",
      "required": ["primary", "secondary"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "secondary": { "$ref": "#/$defs/stringList" }
      }
    },
    "toolchain": {
      "type": "object",
      "required": [
        "compiler_or_interpreter",
        "runtimes",
        "dependency_managers",
        "build_tools",
        "frameworks"
      ],
      "additionalProperties": false,
      "properties": {
        "compiler_or_interpreter": { "type": "string", "minLength": 1 },
        "runtimes": { "$ref": "#/$defs/stringList" },
        "dependency_managers": { "$ref": "#/$defs/stringList" },
        "build_tools": { "$ref": "#/$defs/stringList" },
        "frameworks": { "$ref": "#/$defs/stringList" }
      }
    },
    "command": {
      "type": "object",
      "required": ["status", "argv"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["defined", "unresolved", "not-applicable", "disabled"]
        },
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string", "minLength": 1 },
        "working_directory": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "defined" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "argv": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["unresolved", "not-applicable", "disabled"]
              }
            },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "component": {
      "type": "object",
      "required": [
        "root",
        "languages",
        "toolchain",
        "targets",
        "commands",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string" },
        "languages": { "$ref": "#/$defs/languages" },
        "toolchain": { "$ref": "#/$defs/toolchain" },
        "targets": { "$ref": "#/$defs/stringList" },
        "commands": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "artifacts": { "$ref": "#/$defs/stringList" }
      }
    },
    "assurance": {
      "enum": ["required", "optional", "not-applicable"]
    },
    "artifactContract": {
      "type": "object",
      "required": [
        "immutable",
        "version_source",
        "revision_source",
        "digest_algorithm",
        "provenance",
        "sbom",
        "signature",
        "qualified_by"
      ],
      "additionalProperties": false,
      "properties": {
        "immutable": { "type": "boolean" },
        "version_source": { "enum": ["project.version", "vcs.tag"] },
        "revision_source": { "const": "vcs.commit" },
        "digest_algorithm": { "enum": ["sha256", "sha512"] },
        "provenance": { "$ref": "#/$defs/assurance" },
        "sbom": { "$ref": "#/$defs/assurance" },
        "signature": { "$ref": "#/$defs/assurance" },
        "qualified_by": { "$ref": "#/$defs/stringList" }
      }
    },
    "artifactHandoff": {
      "type": "object",
      "required": ["kind", "reference", "verify_digest"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "orchestrator-artifact",
            "release-asset",
            "package-registry",
            "container-registry",
            "app-store",
            "object-storage"
          ]
        },
        "reference": { "type": "string", "minLength": 1 },
        "verify_digest": { "const": true }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["role", "type", "produced_by", "retention_days"],
      "additionalProperties": false,
      "oneOf": [
        { "required": ["path"] },
        { "required": ["reference"] }
      ],
      "properties": {
        "role": {
          "enum": ["verification-output", "release-artifact"]
        },
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "produced_by": { "$ref": "#/$defs/id" },
        "retention_days": { "type": "integer", "minimum": 1 },
        "platform": { "type": "string" },
        "architecture": { "type": "string" },
        "contract": { "$ref": "#/$defs/artifactContract" },
        "handoff": { "$ref": "#/$defs/artifactHandoff" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "release-artifact" } },
            "required": ["role"]
          },
          "then": { "required": ["contract"] }
        },
        {
          "if": {
            "properties": { "role": { "const": "verification-output" } },
            "required": ["role"]
          },
          "then": { "not": { "required": ["contract"] } }
        }
      ]
    },
    "failure": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["stop", "continue", "retry", "rollback"] },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "delay_seconds": { "type": "integer", "minimum": 0 },
        "rollback_operation": { "$ref": "#/$defs/id" }
      }
    },
    "operation": {
      "type": "object",
      "required": ["phase", "uses"],
      "additionalProperties": false,
      "properties": {
        "phase": { "enum": ["verify", "produce", "deliver", "operate"] },
        "uses": { "$ref": "#/$defs/id" },
        "component": { "$ref": "#/$defs/id" },
        "command": { "$ref": "#/$defs/command" },
        "needs": { "$ref": "#/$defs/stringList" },
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "environment": { "$ref": "#/$defs/id" },
        "secrets": { "$ref": "#/$defs/stringList" },
        "condition": { "type": "object" },
        "timeout_minutes": { "type": "integer", "minimum": 1 },
        "idempotent": { "type": "boolean" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["orchestrator", "operations"],
      "additionalProperties": false,
      "properties": {
        "orchestrator": { "$ref": "#/$defs/id" },
        "triggers": { "$ref": "#/$defs/stringList" },
        "procedure": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+"
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "scopeIntentTarget": {
      "type": "object",
      "required": ["kind", "platform"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "channel": { "type": "string", "minLength": 1 }
      }
    },
    "scopeIntent": {
      "type": "object",
      "required": ["targets"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scopeIntentTarget" }
        }
      }
    },
    "deliveryScope": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["active", "deferred", "unresolved", "not-applicable"]
        },
        "execution": { "enum": ["manual", "automated", "hybrid"] },
        "pipelines": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "reason": { "type": "string", "minLength": 1 },
        "intent": { "$ref": "#/$defs/scopeIntent" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "active" } },
            "required": ["status"]
          },
          "then": { "required": ["execution", "pipelines"] }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["deferred", "unresolved", "not-applicable"]
              }
            },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "delivery": {
      "type": "object",
      "required": ["scopes"],
      "additionalProperties": false,
      "properties": {
        "scopes": {
          "type": "object",
          "required": [
            "development",
            "release",
            "distribution",
            "operation"
          ],
          "additionalProperties": false,
          "properties": {
            "development": { "$ref": "#/$defs/deliveryScope" },
            "release": { "$ref": "#/$defs/deliveryScope" },
            "distribution": { "$ref": "#/$defs/deliveryScope" },
            "operation": { "$ref": "#/$defs/deliveryScope" }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "targets": { "$ref": "#/$defs/stringList" },
        "approvals": {
          "type": "object",
          "required": ["required", "minimum"],
          "additionalProperties": false,
          "properties": {
            "required": { "type": "boolean" },
            "minimum": { "type": "integer", "minimum": 0 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "required": { "const": true } },
                "required": ["required"]
              },
              "then": {
                "properties": { "minimum": { "minimum": 1 } }
              }
            }
          ]
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_operations": { "$ref": "#/$defs/stringList" },
            "require_signed_artifacts": { "type": "boolean" }
          }
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "enum": ["recreate", "rolling", "blue-green", "canary", "manual"]
            },
            "rollback_operation": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "secretReference": {
      "type": "object",
      "required": ["provider", "reference", "required_by"],
      "additionalProperties": false,
      "properties": {
        "provider": { "$ref": "#/$defs/id" },
        "reference": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "required_by": { "$ref": "#/$defs/stringList" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["declared_by", "last_verified"],
      "additionalProperties": true,
      "properties": {
        "declared_by": {
          "enum": ["human", "tool", "mixed", "unresolved"]
        },
        "last_verified": { "type": "string", "minLength": 1 }
      }
    }
  }
}
